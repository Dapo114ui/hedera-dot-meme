# Contract deployment config (Hardhat/Node scripts only - read via
# dotenv from a plain `.env` file, never `.env.local`, and never
# VITE_-prefixed). Copy this file to `.env` and fill in real values.
# `.env` is gitignored; DO NOT commit real keys.

# Funded Hedera testnet account's raw ECDSA private key (hex). Pays gas
# for deployment and every create() call's HTS network-fee buffer.
DEPLOYER_PRIVATE_KEY=

# EVM address that receives creation-fee margin and trading fees.
PLATFORM_TREASURY_ADDRESS=

# Optional - defaults shown are what test/contracts/OnycBondingCurve.test.cjs
# already exercises.
CREATION_FEE_HBAR=45
TRADING_FEE_BPS=100
FUNDING_GOAL_HBAR=72270
